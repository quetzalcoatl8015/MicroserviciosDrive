# ---------------------------------------------------------------------------
# Plantilla de variables de entorno para Docker.
#
# Cómo se usa:
#   1. Copia este archivo y llámalo ".env" en la raíz del proyecto.
#   2. Cambia los valores que necesites. Los que no definas toman el valor por
#      omisión escrito en docker-compose.yml.
#   3. Ejecuta "docker compose up -d".
#
# El archivo ".env" NO se versiona en Git (ver .gitignore) porque puede contener
# contraseñas y claves reales. Este archivo ".env.example" sí se versiona: es la
# plantilla que le dice a quien clona el repositorio qué variables existen.
#
# Docker Compose lee el archivo ".env" automáticamente desde la carpeta donde se
# ejecuta el comando, sin necesidad de declararlo en el docker-compose.yml.
# ---------------------------------------------------------------------------

# --- Base de datos MySQL ---
# Contraseña del usuario root de MySQL. En un entorno real debe ser larga y
# distinta a esta; aquí se deja la de desarrollo para que el proyecto arranque
# sin configuración adicional.
MYSQL_ROOT_PASSWORD=password

# Nombre de la base de datos que se crea al arrancar MySQL. Debe coincidir con el
# que usa la cadena de conexión de la API.
MYSQL_DATABASE=ProyectoM

# Puerto del equipo en el que queda publicada la base de datos. El 3306 por
# omisión; se puede cambiar si ya se tiene otro MySQL instalado en la máquina.
MYSQL_PORT=3306

# --- API del repositorio ---
# Puerto del equipo en el que queda publicada la API.
API_PORT=5239

# Clave con la que se firman los JWT.
#
# ADVERTENCIA: si esta clave cambia, todos los tokens emitidos antes dejan de ser
# válidos y los usuarios con sesión abierta tendrán que volver a iniciar sesión.
# En un entorno real debe ser una cadena larga y aleatoria.
JWT_CLAVE_SECRETA=koNGJ89L4gn9w@0ifAsmf#opdZsgmx_O

# Modo de ejecución de la API: Development o Production.
ASPNETCORE_ENVIRONMENT=Development

# --- Frontend ---
# Puerto del equipo en el que queda publicada la interfaz web.
FRONTEND_PORT=5173

# Dirección de la API que usará el NAVEGADOR del usuario.
#
# Tiene que ser una dirección alcanzable desde la máquina donde se abre el
# navegador: "http://localhost:5239/api" sirve para uso local. Si el proyecto se
# publica en un servidor, aquí va la dirección pública de la API.
#
# Ojo: Vite escribe este valor dentro del JavaScript al compilar, así que al
# cambiarlo hay que reconstruir la imagen con "docker compose build frontend".
VITE_API_URL=http://localhost:5239/api

# Origen autorizado a llamar a la API (CORS). Debe coincidir exactamente con la
# dirección desde la que se abre el frontend en el navegador: protocolo, nombre y
# puerto, sin barra final.
FRONTEND_ORIGIN=http://localhost:5173
